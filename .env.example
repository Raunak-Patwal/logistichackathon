# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Logistics Brain"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_password
POSTGRES_DB=logistics_brain

# SQLAlchemy Database URL (Constructed automatically if left blank)
# DATABASE_URL=postgresql+asyncpg://logistics_user:logistics_password@localhost:5432/logistics_brain

# Redis Streams & Real-Time Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini AI Reasoning & PgVector RAG Configuration
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourActualKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

